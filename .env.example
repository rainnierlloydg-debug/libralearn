APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_URL=
DB_SSLMODE=
# Deployment only: enable after reviewing migrations for the target database.
RUN_MIGRATIONS=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_CLOUD_VISION_API_URL=
GEMINI_API_KEY=
GEMINI_CATALOG_API_KEY=
GEMINI_API_URL=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPEN_LIBRARY_API_URL=https://openlibrary.org/search.json
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_API_URL=https://www.googleapis.com/books/v1/volumes

# Cover uploads. Local: COVERS_DISK=public (run php artisan storage:link).
# Production (Supabase Storage S3 API): COVERS_DISK=s3, AWS_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3,
# AWS_USE_PATH_STYLE_ENDPOINT=true, AWS_DEFAULT_REGION=<project region>, AWS_BUCKET=<public bucket>,
# AWS_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>, keys from Storage > S3 access keys.
COVERS_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=

VITE_APP_NAME="${APP_NAME}"

# GSA library rules (config/library.php). fine_per_day is edited by the
# librarian in the app; LIBRARY_FINE_PER_DAY is only the starting default.
LIBRARY_SCHOOL_NAME="Good Shepherd Academy"
LIBRARY_TIMEZONE=Asia/Manila
LIBRARY_LOAN_DAYS=3
LIBRARY_MAX_ACTIVE_LOANS=3
LIBRARY_MAX_RENEWALS=1
LIBRARY_RENEWAL_DAYS=1
LIBRARY_FINE_PER_DAY=
LIBRARY_INSIGHTS_MONTHS=6
LIBRARY_TURNAROUND_DAYS=1
LIBRARY_TARGET_UTILIZATION=0.7
LIBRARY_INSIGHTS_CACHE_MINUTES=30
LIBRARY_FORECAST_ENABLED=
LIBRARY_FORECAST_PYTHON=

# Local PostgreSQL test database (php artisan test --configuration=phpunit.pgsql.xml)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=libralearn
PG_TEST_DATABASE=libralearn_test
PG_USERNAME=postgres
PG_PASSWORD=

# Frontend origin(s) allowed to call the API (comma-separated). Production: your Vercel URL.
CORS_ALLOWED_ORIGINS=*
